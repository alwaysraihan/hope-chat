# Resolve react_native_pods.rb with node to allow for hoisting
require_relative '../node_modules/react-native-permissions/scripts/setup'

require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# react-native-permissions only compiles the handlers listed here; without this
# every check()/request() resolves to 'unavailable'.
setup_permissions([
  'Camera',
  'Microphone',
  'PhotoLibrary',
  'PhotoLibraryAddOnly',
  'Notifications',
])

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'hopeChat' do
  config = use_native_modules!

  # Firebase pods need module maps to be importable from Swift when built as static libraries
  pod 'FirebaseCore', :modular_headers => true
  pod 'FirebaseCoreInternal', :modular_headers => true
  pod 'GoogleUtilities', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # react-native-callkeep / react-native-voip-push-notification are plain
    # Objective-C pods that don't set DEFINES_MODULE themselves, so CocoaPods
    # never generates a Clang module map for them even under use_frameworks! —
    # that's what made Swift's `import RNCallKeep` in AppDelegate.swift fail
    # with "no such module 'RNCallKeep'". Forcing it on just these two targets
    # (not every pod) keeps this scoped to the actual problem.
    installer.pods_project.targets.each do |target|
      if ['RNCallKeep', 'RNVoipPushNotification'].include?(target.name)
        target.build_configurations.each do |bc|
          bc.build_settings['DEFINES_MODULE'] = 'YES'
        end
      end
    end
  end
end
