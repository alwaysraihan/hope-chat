<!--
  Status-bar / small notification icon.

  Android renders the small icon as a SILHOUETTE: every non-transparent pixel is
  painted in the notification tint, so it must be a flat white-on-transparent
  shape. There was no such drawable at all, so notifications fell back to the
  launcher icon, which the system flattened into the empty ring seen next to
  HopeChat messages while WhatsApp/Messenger/Discord showed a proper mark.

  A vector is used so it scales to every density without shipping six PNGs.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFFFF">
  <!-- Speech bubble with a tail: reads clearly at 24dp in a status bar. -->
  <path
      android:fillColor="#FFFFFFFF"
      android:pathData="M12,3C7.03,3 3,6.58 3,11c0,2.27 1.07,4.31 2.79,5.74C5.6,17.9 4.96,19.1 4,20c1.86,-0.13 3.3,-0.72 4.35,-1.35C9.5,18.87 10.72,19 12,19c4.97,0 9,-3.58 9,-8S16.97,3 12,3z" />
</vector>
