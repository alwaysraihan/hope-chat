<!--
  Status-bar / small notification icon — the HopeChat mark.

  Android renders the small icon as a SILHOUETTE: every non-transparent pixel is
  repainted in the notification tint, so this must be a flat white-on-transparent
  shape with no colour of its own. It is also what Android badges over the large
  icon in MessagingStyle — the little app mark in the corner of the sender's
  photo, exactly like WhatsApp. It was a generic speech bubble, so that badge did
  not read as HopeChat.

  Traced from ic_launcher_foreground: bubble outline + "H" + smile. Strokes are
  1.7dp so the shape survives the 24dp status-bar render.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFFFF">

  <!-- Speech bubble with the tail at the lower left. -->
  <path
      android:strokeColor="#FFFFFFFF"
      android:strokeWidth="1.7"
      android:strokeLineCap="round"
      android:strokeLineJoin="round"
      android:fillColor="#00000000"
      android:pathData="M12,2.9c4.8,0 8.6,3.7 8.6,8.2c0,4.5 -3.8,8.2 -8.6,8.2c-1,0 -2,-0.2 -2.9,-0.5l-3.2,1.9c-0.4,0.2 -0.9,-0.2 -0.8,-0.7l0.6,-2.4C3.6,16.1 2.4,13.9 2.4,11.1C2.4,6.6 6.3,2.9 12,2.9z" />

  <!-- The "H": two uprights crossed by the diagonal. -->
  <path
      android:strokeColor="#FFFFFFFF"
      android:strokeWidth="1.7"
      android:strokeLineCap="round"
      android:fillColor="#00000000"
      android:pathData="M9.9,7.4L9.9,12.4" />
  <path
      android:strokeColor="#FFFFFFFF"
      android:strokeWidth="1.7"
      android:strokeLineCap="round"
      android:fillColor="#00000000"
      android:pathData="M14.1,7.4L14.1,12.4" />
  <path
      android:strokeColor="#FFFFFFFF"
      android:strokeWidth="1.7"
      android:strokeLineCap="round"
      android:fillColor="#00000000"
      android:pathData="M8.7,11.2L15.3,8.6" />

  <!-- Smile. -->
  <path
      android:strokeColor="#FFFFFFFF"
      android:strokeWidth="1.7"
      android:strokeLineCap="round"
      android:fillColor="#00000000"
      android:pathData="M9,13.9c0.7,1.2 1.8,1.9 3,1.9c1.2,0 2.3,-0.7 3,-1.9" />
</vector>
